{
  "MicroplateCentrifugeCommandExecutor": {
    "Port": "50052",
    "loaderProfileName": "loaderTest"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "MicroplateCentrifugeCommandExecutor.log",
          "rollOnFileSizeLimit": true
        }
      }
    ]
  }
}